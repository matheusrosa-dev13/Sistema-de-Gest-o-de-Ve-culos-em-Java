public class Carro extends Veiculo {
    private int qtdPortas;

    public Carro(String marca, String modelo, int ano, double valorDiaria, int qtdPortas) {
        super(marca, modelo, ano, valorDiaria);
        this.qtdPortas = qtdPortas;
    }

    public int getQtdPortas() {
        return qtdPortas;
    }

    public void setQtdPortas(int qtdPortas) {
        this.qtdPortas = qtdPortas;
    }

    @Override
    public void exibirInfo() {
        super.exibirInfo();
        System.out.println("Tipo: Carro | Quantidade de Portas: " + qtdPortas);
    }

    @Override
    public double calcularDiaria(int dias) {
        double taxaLimpeza = 30.0;
        return super.calcularDiaria(dias) + taxaLimpeza;
    }
}
